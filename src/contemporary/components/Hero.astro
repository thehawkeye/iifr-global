---
/**
 * Hero — homepage and top-of-page hero.
 *
 * Murali spec (L1, t_dadf4467, 2026-08-06, refined 22:48 IST):
 *   - Watercolor hero — artistic, NOT the building photograph.
 *     Real raster watercolour asset (home-watercolor-hero.webp) sits
 *     behind the copy with object-fit:cover so it scales without
 *     distortion across viewports. A restrained solid/linear overlay
 *     above the art keeps text readable without hiding the painting.
 *     Clear fade to ivory at the bottom so the hero lands visually
 *     into the rest of the page.
 *   - IIFR emblem + full institute name as a quiet crest above the title.
 *   - TrustStrip moved to a separate <TrustStrip /> component below
 *     (matches iifr.global's navy band with label/value pairs).
 *   - NO live-cohort signal pill in the hero (Murali 22:48 — classy,
 *     not crass; the pill decoration was the wrong call).
 *   - NO Founding Batch Scholarship callout in the hero (same).
 *     The term lives in the ECP detail body as plain prose.
 *   - NO "Pracademic" highlight in the hero (Murali 22:48 — the term
 *     belongs in body copy, not in styled callouts).
 */
import { programmes } from "../lib/content";

interface Cta {
  href: string;
  label: string;
  variant?: "primary" | "outline" | "ghost" | "secondary";
}

interface Props {
  title: string;
  /** A one- or two-sentence value proposition. */
  lead: string;
  primary: Cta;
  secondary?: Cta;
}

const { title, lead, primary, secondary } = Astro.props as Props;

// `programmes` is imported to keep the live-cohort signal logic available
// for callers that opt in later (e.g. the ECP detail page), but the home
// hero does not render it.
void programmes;

// Real raster watercolour hero. Focal point sits slightly right-of-centre
// (60% / 40%) so the navy text-safe field of the painting stays behind the
// copy while the maroon bloom on the right remains visible at wide widths.
const WATERCOLOR_SRC = "/assets/images/contemporary/home-watercolor-hero.webp";
const WATERCOLOR_WIDTH = 2400;
const WATERCOLOR_HEIGHT = 1125;
---

<section class="cp-hero" aria-labelledby="cp-hero-title">
  <picture class="cp-hero__art" aria-hidden="true">
    <img
      class="cp-hero__art-img"
      src={WATERCOLOR_SRC}
      alt=""
      width={WATERCOLOR_WIDTH}
      height={WATERCOLOR_HEIGHT}
      decoding="async"
      loading="eager"
      fetchpriority="high"
    />
  </picture>
  <div class="cp-hero__overlay" aria-hidden="true"></div>

  <div class="cp-container cp-container--wide cp-hero__inner">
    <div class="cp-hero__copy">
      <a class="cp-hero__brand" href="/contemporary" aria-label="IIFR — home">
        <img
          class="cp-hero__emblem"
          src="/assets/logo.webp"
          alt="IIFR emblem"
          width="56"
          height="56"
          decoding="async"
        />
        <span class="cp-hero__brand-name">
          International Institute for Faculty &amp; Research
        </span>
      </a>

      <h1 id="cp-hero-title" class="cp-hero__title">{title}</h1>
      <p class="cp-hero__lead">{lead}</p>

      <div class="cp-hero__actions">
        <a class={`cp-button cp-button--${primary.variant ?? "primary"}`} href={primary.href}>
          {primary.label}
        </a>
        {secondary && (
          <a class={`cp-button cp-button--${secondary.variant ?? "outline"}`} href={secondary.href}>
            {secondary.label}
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * Watercolor hero: real raster watercolour (home-watercolor-hero.webp)
   * sits behind a restrained navy→ivory overlay. The overlay is mostly
   * transparent so the painting is fully visible — it only darkens the
   * top half enough for white copy to read and then fades to ivory at
   * the bottom so the hero lands visually into the rest of the page.
   */
  /*
   * Z-index scheme (FIX 2026-08-07, Murali: "no watercolor hero on home"):
   *   .cp-hero         — no opaque background; art supplies the colour.
   *   .cp-hero__art    — z-index 0; the raster watercolour layer.
   *   .cp-hero__overlay— z-index 1; readable-text overlay, fades to ivory.
   *   .cp-hero__inner  — z-index 2; copy + CTAs read on top of art.
   * No `isolation: isolate` — we want everything in normal flow.
   */
  .cp-hero {
    position: relative;
    overflow: hidden;
    min-height: clamp(440px, 62vh, 660px);
    display: flex;
    align-items: center;
    color: #ffffff;
    padding: clamp(3rem, 2rem + 4vw, 5rem) 0;
    background: var(--cp-color-ivory);
  }

  .cp-hero__art {
    position: absolute;
    inset: 0;
    z-index: 0;
    margin: 0;
    pointer-events: none;
  }

  .cp-hero__art-img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: 60% 40%;
  }

  .cp-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgba(36, 47, 76, 0.45) 0%,
        rgba(36, 47, 76, 0.30) 35%,
        rgba(36, 47, 76, 0) 60%,
        var(--cp-color-ivory) 100%
      );
    pointer-events: none;
  }

  .cp-hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .cp-hero__copy {
    max-width: 60ch;
  }

  .cp-hero__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.75rem;
    text-decoration: none;
    color: inherit;
  }

  .cp-hero__brand:hover,
  .cp-hero__brand:focus-visible {
    color: inherit;
    text-decoration: none;
  }

  .cp-hero__emblem {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
  }

  .cp-hero__brand-name {
    font-family: var(--cp-font-heading);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #ffffff;
    line-height: 1.25;
    max-width: 26ch;
  }

  .cp-hero__title {
    color: #ffffff;
    font-size: var(--cp-font-size-title);
    margin: 0 0 1rem;
    letter-spacing: -0.01em;
    text-wrap: balance;
    text-shadow: 0 2px 24px rgba(36, 47, 76, 0.35);
  }

  .cp-hero__lead {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.96);
    max-width: 58ch;
    margin: 0 0 1.75rem;
    text-shadow: 0 1px 12px rgba(36, 47, 76, 0.35);
  }

  .cp-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cp-hero__actions .cp-button--outline {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.7);
  }

  .cp-hero__actions .cp-button--outline:hover,
  .cp-hero__actions .cp-button--outline:focus-visible {
    background: #ffffff;
    color: var(--cp-color-navy);
  }

  /*
   * Mobile gets a slightly heavier top darkening because small viewports
   * crop the painting tighter and the navy text-safe centre may not be
   * fully behind the copy at narrow widths.
   */
  @media (max-width: 767.98px) {
    .cp-hero__art-img {
      object-position: 50% 35%;
    }

    .cp-hero__overlay {
      background:
        linear-gradient(
          180deg,
          rgba(36, 47, 76, 0.58) 0%,
          rgba(36, 47, 76, 0.40) 30%,
          rgba(36, 47, 76, 0.05) 55%,
          var(--cp-color-ivory) 100%
        );
    }
  }

  /*
   * Reduced motion: keep the art and overlay static — the original
   * animated bloom discs are gone, so this block is here to document
   * intent and to guard against any future motion creep on the hero.
   */
  @media (prefers-reduced-motion: reduce) {
    .cp-hero__art,
    .cp-hero__art-img,
    .cp-hero__overlay {
      animation: none;
      transition: none;
    }
  }
</style>
