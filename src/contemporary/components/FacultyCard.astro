---
/**
 * FacultyCard — used in the research-and-faculty hub. A person
 * card answers "why this person is relevant to my decision", not
 * just "what their title is" (per design plan §6.6).
 *
 * Accepts either a `faculty` (legacy FacultyProfile from
 * content.ts) or a `person` (Person from lib/people.ts). The two
 * shapes share displayName, roleAtIIFR, currentAffiliation,
 * shortBio, slug, roleCategory.
 */
import type { FacultyProfile } from "../lib/content";
import type { Person } from "../lib/people";

interface Props {
  faculty?: FacultyProfile;
  person?: Person;
}

const props = Astro.props as Props;
const faculty = props.faculty ?? props.person;
if (!faculty) throw new Error("FacultyCard requires a `faculty` or `person` prop");
const slug = faculty.slug;
const href = `/contemporary/research-and-faculty/faculty/${slug}`;
const tag = faculty.roleCategory;
const display = faculty.displayName;
const role = faculty.roleAtIIFR;
const affiliation = faculty.currentAffiliation;
const bio = faculty.shortBio;
---

<a class="cp-card cp-card--link cp-faculty-card" href={href}>
  <span class="cp-tag cp-tag--navy">{tag}</span>
  <h3>{display}</h3>
  <p class="cp-faculty-card__role">{role}</p>
  <p class="cp-faculty-card__affiliation">{affiliation}</p>
  <p class="cp-faculty-card__bio">{bio}</p>
  <div class="cp-card__cta">
    <span>View profile</span> <span aria-hidden="true">→</span>
  </div>
</a>

<style>
  .cp-faculty-card h3 {
    margin: 0.75rem 0 0.25rem;
    font-size: 1.25rem;
  }

  .cp-faculty-card__role {
    margin: 0;
    color: var(--cp-color-maroon);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .cp-faculty-card__affiliation {
    margin: 0.4rem 0 1rem;
    color: var(--cp-color-text-muted);
    font-size: 0.875rem;
  }

  .cp-faculty-card__bio {
    color: var(--cp-color-text-muted);
    margin: 0 0 1rem;
  }
</style>
