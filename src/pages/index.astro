---
/**
 * index.astro — the home page.
 *
 * Phase 2 T2: full home page content ported from `app/home.php`. The page
 * composition (Hero → Trust band → Who we are / Partners → Audience → Offerings
 * → Faculty credibility → Insights → Final CTA) is identical to production so
 * the existing `iifr-redesign.css` stylesheet renders it correctly.
 *
 * Asset references go through `assetUrl()` so the static assets stay on
 * Hostinger (per M5 / webdev-phase2-build-plan.md §0). Internal links use
 * clean Astro paths (no `.php`).
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import { assetUrl } from "../lib/assetUrl";
---

<SiteLayout path="/" bodyClass="iifr-redesign-scope iifr-home-optimized">
  <!-- ============ HERO — Institutional positioning ============ -->
  <div class="iifr-page-hero iifr-home-hero">
    <div
      class="iifr-page-hero__bg iifr-page-hero__bg--home"
      style={`background-image:url('${assetUrl("assets/images/hero-home.webp")}');`}
    ></div>
    <div class="iifr-page-hero__inner">
      <span class="iifr-page-hero__eyebrow">International Institute for Faculty &amp; Research</span>
      <h1>Advancing Faculty, Research, and Academic Leadership</h1>
      <p>IIFR strengthens teaching excellence, applied research, and practice-academic collaboration for institutions, educators, and experienced professionals across India and the Global South.</p>
      <div class="iifr-page-hero__cta">
        <a href="/programmes" class="iifr-btn-primary">Explore Programmes</a>
        <a href="/about" class="iifr-btn-outline">About IIFR</a>
      </div>
    </div>
  </div>

  <!-- ============ INSTITUTIONAL CREDIBILITY BAND ============ -->
  <section class="iifr-home-trust" aria-label="Institutional credibility">
    <div class="iifr-home-trust__inner">
      <div class="iifr-home-trust__item">
        <span>Established by</span>
        <strong>Bharatiya Vidya Bhavan</strong>
      </div>
      <div class="iifr-home-trust__item">
        <span>Certification</span>
        <strong>EFMD Certification</strong>
      </div>
      <div class="iifr-home-trust__item">
        <span>Faculty model</span>
        <strong>Academics and Professors of Practice</strong>
      </div>
      <div class="iifr-home-trust__item">
        <span>Focus</span>
        <strong>India and the Global South</strong>
      </div>
    </div>
  </section>

  <!-- ============ WHO WE ARE + PARTNERS ============ -->
  <section class="iifr-section iifr-home-section iifr-home-section--identity">
    <div class="iifr-home-identity">
      <div class="iifr-home-identity__copy">
        <span class="iifr-eyebrow">Who We Are</span>
        <h2>IIFR builds capability where academia and practice meet.</h2>
        <p>The International Institute for Faculty &amp; Research is an autonomous academic institute established to strengthen faculty capability, research excellence, and academic leadership.</p>
        <p>It brings scholars, practitioners, business leaders, and institutions together to support impactful pedagogy, applied research, executive education, curriculum design, and thought leadership.</p>
        <div class="iifr-home-identity__actions">
          <a href="/about" class="iifr-btn-dark">Learn About IIFR</a>
          <a href="/research" class="iifr-btn-ghost">Research and Faculty</a>
        </div>
      </div>
      <aside class="iifr-home-partners" aria-label="Strategic partners">
        <h3>Institutional Network</h3>
        <p>Built with trusted academic and institutional partners.</p>
        <div class="iifr-home-partners__logos">
          <div class="iifr-home-partners__logo">
            <img src={assetUrl("assets/images/logo/bvb.png")} alt="Bharatiya Vidya Bhavan" loading="lazy" decoding="async" />
          </div>
          <div class="iifr-home-partners__logo iifr-home-partners__logo--efmd">
            <img src={assetUrl("assets/images/logo/efmd.png")} alt="EFMD Global" loading="lazy" decoding="async" />
          </div>
          <div class="iifr-home-partners__logo">
            <img
              src={assetUrl("assets/images/logo/latticed.png")}
              alt="LatticEd"
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none';this.parentNode.innerHTML='<div style=&quot;font-family:Roboto Slab,Georgia,serif;font-size:24px;color:#0d1b3e;font-weight:700;&quot;>LatticEd</div>';"
            />
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ============ AUDIENCE PATHWAYS ============ -->
  <section class="iifr-section iifr-home-section">
    <div class="iifr-section__head iifr-section__head--center iifr-home-section__head">
      <span class="iifr-eyebrow">Who We Serve</span>
      <h2>Pathways for people and institutions shaping higher education.</h2>
      <p class="iifr-lead">Focused entry points for professionals, faculty, academic leaders, and institutions.</p>
    </div>

    <div class="iifr-home-audience">
      <a href="/ecp" class="iifr-home-audience-card">
        <span class="iifr-home-audience-card__icon"><i class="fa-light fa-briefcase" aria-hidden="true"></i></span>
        <h3>For Senior Professionals</h3>
        <p>Move industry experience into teaching, executive education, and academic influence.</p>
        <span>Explore ECP</span>
      </a>
      <a href="/ecp" class="iifr-home-audience-card">
        <span class="iifr-home-audience-card__icon"><i class="fa-light fa-chalkboard-user" aria-hidden="true"></i></span>
        <h3>For Faculty &amp; Educators</h3>
        <p>Strengthen teaching effectiveness, curriculum design, and classroom impact.</p>
        <span>Explore Certification</span>
      </a>
      <a href="/research" class="iifr-home-audience-card">
        <span class="iifr-home-audience-card__icon"><i class="fa-light fa-building-columns" aria-hidden="true"></i></span>
        <h3>For Academic Leaders</h3>
        <p>Build academic leadership, faculty development, and institutional capability.</p>
        <span>View Faculty Work</span>
      </a>
      <a href="/contact" class="iifr-home-audience-card">
        <span class="iifr-home-audience-card__icon"><i class="fa-light fa-handshake" aria-hidden="true"></i></span>
        <h3>For Institutions</h3>
        <p>Partner with IIFR on faculty development, research, and practice-led learning.</p>
        <span>Contact IIFR</span>
      </a>
    </div>
  </section>

  <!-- ============ OFFERINGS ============ -->
  <section class="iifr-section iifr-home-section iifr-cream">
    <div class="iifr-section__head iifr-section__head--center iifr-home-section__head">
      <span class="iifr-eyebrow">What We Offer</span>
      <h2>High-impact programmes and institutional pathways.</h2>
      <p class="iifr-lead">Practice-oriented learning experiences for educators, leaders, researchers, and institutions.</p>
    </div>

    <div class="iifr-home-offerings">
      <a href="/ecp" class="iifr-home-offering iifr-home-offering--featured">
        <span class="iifr-home-offering__tag">Certification</span>
        <h3>Educators' Certificate Programme</h3>
        <p>For professionals, faculty, and educators building capability in teaching, executive education, and academic influence.</p>
        <span class="iifr-home-offering__more">Learn More</span>
      </a>
      <a href="/efm" class="iifr-home-offering">
        <span class="iifr-home-offering__tag">Executive</span>
        <h3>Executive Fellow in Management</h3>
        <p>For senior leaders seeking to contribute through applied research, mentoring, teaching, and thought leadership.</p>
        <span class="iifr-home-offering__more">Learn More</span>
      </a>
      <a href="/applied-research" class="iifr-home-offering">
        <span class="iifr-home-offering__tag">Research</span>
        <h3>Research &amp; Faculty Development</h3>
        <p>Short-format programmes focused on teaching excellence, research capability, and leadership development.</p>
        <span class="iifr-home-offering__more">Learn More</span>
      </a>
      <a href="/contact" class="iifr-home-offering">
        <span class="iifr-home-offering__tag">Partnerships</span>
        <h3>Institutional Partnerships</h3>
        <p>Collaborate with IIFR on faculty capability, academic leadership, and practice-informed learning initiatives.</p>
        <span class="iifr-home-offering__more">Engage with Us</span>
      </a>
    </div>
  </section>

  <!-- ============ FACULTY CREDIBILITY PREVIEW ============ -->
  <section class="iifr-home-faculty">
    <div class="iifr-home-faculty__inner">
      <div>
        <span class="iifr-eyebrow">Academic Credibility</span>
        <h2>Learning shaped by academic and practice leadership.</h2>
      </div>
      <p>IIFR brings together globally connected academicians, senior industry professionals, Professors of Practice, and research leaders working at the intersection of education, industry, and policy.</p>
      <a href="/research" class="iifr-btn-primary">Meet Research and Faculty</a>
    </div>
  </section>

  <!-- ============ INSIGHTS FROM IIFR ============ -->
  <section class="iifr-section iifr-home-section">
    <div class="iifr-home-insights">
      <div class="iifr-home-insights__intro">
        <span class="iifr-eyebrow">Insights</span>
        <h2>Perspectives from IIFR</h2>
        <p>Ideas on higher education, faculty development, research, leadership, and professional practice.</p>
        <a href="/insights" class="iifr-btn-ghost">View All Insights</a>
      </div>
      <div class="iifr-home-insights__list">
        <a href="/blog/faculty-development" class="iifr-home-insight-link">
          <span>May 15, 2026</span>
          <strong>Rethinking Faculty Development in India</strong>
        </a>
        <a href="/blog/academia-industry" class="iifr-home-insight-link">
          <span>April 28, 2026</span>
          <strong>Bridging Academia and Industry</strong>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="iifr-home-close">
    <div class="iifr-home-close__inner">
      <h2>Explore programmes designed for educators, practitioners, and institutions.</h2>
      <div class="iifr-page-hero__cta">
        <a href="/programmes" class="iifr-btn-primary">View Programmes</a>
        <a href="/contact" class="iifr-btn-outline">Contact Us</a>
      </div>
    </div>
  </section>
</SiteLayout>
