# Keystatic config — populated in Phase 3 once the GitHub OAuth app is wired up.
# Phase 1 uses `local` storage in keystatic.config.ts; the env vars below are
# the no-op defaults Keystatic expects to read at boot. Keeping them here means
# Phase 3 can flip `storage.kind` to `github` without re-scaffolding the file.
#
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# PUBLIC_KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
