---
/**
 * FloatCta — fixed "Apply Now" phone-style button.
 *
 * Port of `partials/components/float-cta.php`. Opens the site-wide apply
 * modal (Bootstrap data attributes target #iifrApplyModal) rather than
 * navigating to /apply.
 */
---

<div class="iifr-float-cta" aria-label="Quick actions">
  <a
    class="iifr-float-btn iifr-float-btn--gold"
    href="/apply"
    data-bs-toggle="modal"
    data-bs-target="#iifrApplyModal"
    data-iifr-lead-intent="apply"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92Z" />
    </svg>
    Apply Now
  </a>
</div>
