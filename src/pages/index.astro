---
/**
 * index.astro — the home page.
 *
 * Phase 2 placeholder: this file proves the design foundation works end
 * to end — header active state, footer rendering, assetUrl resolving,
 * apply modal, offcanvas, search overlay, legacy styles, and the SEO
 * head. T2 will replace this with the full home page content.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import { assetUrl } from "../lib/assetUrl";
---

<SiteLayout path="/" bodyClass="iifr-redesign-scope iifr-home-optimized">
  <!-- HERO -->
  <div class="iifr-page-hero iifr-home-hero">
    <div
      class="iifr-page-hero__bg iifr-page-hero__bg--home"
      style={`background-image:url('${assetUrl("assets/images/hero-home.webp")}');`}
    ></div>
    <div class="iifr-page-hero__inner">
      <span class="iifr-page-hero__eyebrow">International Institute for Faculty &amp; Research</span>
      <h1>Advancing Faculty, Research, and Academic Leadership</h1>
      <p>
        IIFR strengthens teaching excellence, applied research, and
        practice-academic collaboration for institutions, educators, and
        experienced professionals across India and the Global South.
      </p>
      <div class="iifr-page-hero__cta">
        <a href="/programmes" class="iifr-btn-primary">Explore Programmes</a>
        <a href="/about" class="iifr-btn-outline">About IIFR</a>
      </div>
    </div>
  </div>

  <!-- Trust band -->
  <section class="iifr-home-trust" aria-label="Institutional credibility">
    <div class="iifr-home-trust__inner">
      <div class="iifr-home-trust__item">
        <span>Established by</span>
        <strong>Bharatiya Vidya Bhavan</strong>
      </div>
      <div class="iifr-home-trust__item">
        <span>Certification</span>
        <strong>EFMD Certification</strong>
      </div>
      <div class="iifr-home-trust__item">
        <span>Faculty model</span>
        <strong>Academics and Professors of Practice</strong>
      </div>
      <div class="iifr-home-trust__item">
        <span>Focus</span>
        <strong>India and the Global South</strong>
      </div>
    </div>
  </section>

  <!-- T1 foundation marker (T2 replaces with real copy) -->
  <section class="iifr-section" aria-label="Phase 2 status">
    <div class="container">
      <span class="iifr-eyebrow">Phase 2 · Status</span>
      <h2>Design foundation online</h2>
      <p>
        T1 (design foundation) is live on Vercel preview. Header, footer,
        offcanvas, search overlay, apply modal, and SEO head are wired and
        rendering. Tier-1 page content lands in T2.
      </p>
      <p>
        <a class="iifr-btn-primary" href="/keystatic">Open Keystatic admin</a>
      </p>
    </div>
  </section>
</SiteLayout>
