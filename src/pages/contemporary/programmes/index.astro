---
/**
 * /contemporary/programmes — programme index.
 *
 * Lists every programme with status, audience, format, duration,
 * and a comparison CTA. Includes a quick filter section (open,
 * coming-soon, by-enquiry) implemented as anchor links — the
 * full filter UI is intentionally not built for the prototype.
 */
import ContemporaryBaseLayout from "../../../contemporary/layouts/ContemporaryBaseLayout.astro";
import PageHero from "../../../contemporary/components/PageHero.astro";

import ProgrammeCard from "../../../contemporary/components/ProgrammeCard.astro";
import { programmes } from "../../../contemporary/lib/content";
import { SITE_URL, programmesListSchema } from "../../../contemporary/lib/seo";

const url = new URL(Astro.request.url);
const filterParam = (url.searchParams.get("status") ?? "all").toLowerCase();
const validFilters = new Set(["all", "open", "by-enquiry", "coming-soon", "archived"]);
const activeFilter = validFilters.has(filterParam) ? filterParam : "all";
const baseAll = programmes;
const baseFiltered = activeFilter === "all"
  ? baseAll
  : baseAll.filter((p) => {
      if (activeFilter === "open") return p.status === "open" || p.status === "coming-soon";
      return p.status === activeFilter;
    });
const open = baseAll.filter((p) => p.status === "open" || p.status === "coming-soon");
const byEnquiry = baseAll.filter((p) => p.status === "by-enquiry");

const seo = {
  title: "IIFR programmes | Compare ECP, EFM, and faculty development",
  description:
    "Explore IIFR programmes for individuals, faculty, and institutions. Compare ECP, EFM, faculty development workshops, and custom executive education.",
  keywords:
    "IIFR programmes, ECP, EFM, faculty development, executive education, custom programmes, compare programmes",
  canonical: `${SITE_URL}/contemporary/programmes`,
  image: `/assets/images/programmes/programmes-hero.jpeg`,
  type: "website" as const,
  schema: "ItemList" as const,
};

const schema = programmesListSchema(programmes);
---

<ContemporaryBaseLayout
  path="/contemporary/programmes"
  seo={seo}
  schema={schema}
  breadcrumbs={[
    { label: "Home", href: "/contemporary" },
    { label: "Programmes" },
  ]}
>
  <PageHero eyebrow="Programmes" title="Programmes designed for decision and capability."
    lead="IIFR offers programmes for individuals moving into teaching and academic influence, for faculty and academic leaders, and for institutions building capability."
    image={{ src: "/assets/images/programmes/programmes-hero.jpeg", alt: "Faculty member teaching in a lecture hall" }}
    primary={{ href: "/contemporary/find-your-pathway", label: "Find your pathway" }}
    secondary={{ href: "/contemporary/programmes/compare", label: "Compare programmes", variant: "outline" }} />

  {/*
    Pracademic band (R4, t_6078f9e1) — visible emphasis on the term
    "pracademic" beneath the PageHero. Repeated on every programme
    detail so the vocabulary is consistent across the hub and the
    per-programme pages.
  */}
  <section class="cp-section cp-section--tight" aria-labelledby="cp-programmes-pracademic">
    <div class="cp-container">
      <div class="cp-pracademic-band" id="cp-programmes-pracademic">
        <span class="cp-pracademic-band__eyebrow">Pracademic</span>
        <p class="cp-pracademic-band__body">
          Every programme at IIFR is built around the <strong>pracademic</strong> —
          practitioners who teach, research, and lead at the bridge between the
          classroom and the field. The term is the centre of gravity for how
          we design learning, faculty mix, and applied scholarship.
        </p>
      </div>
    </div>
  </section>

  <section class="cp-section" id="open" aria-labelledby="cp-open-programmes">
    <div class="cp-container">
      <h2 id="cp-open-programmes">Open and coming soon</h2>
      <p class="cp-section__intro">
        Programmes with a live or upcoming cohort you can apply to.
      </p>
      <div class="cp-grid cp-grid--2">
        {open.map((p) => <ProgrammeCard programme={p} />)}
      </div>
    </div>
  </section>

  <section class="cp-section cp-section--ivory" id="by-enquiry" aria-labelledby="cp-by-enquiry-programmes">
    <div class="cp-container">
      <h2 id="cp-by-enquiry-programmes">By enquiry</h2>
      <p class="cp-section__intro">
        Programmes designed per engagement. Talk to IIFR to scope what you need.
      </p>
      <div class="cp-grid cp-grid--2">
        {byEnquiry.map((p) => <ProgrammeCard programme={p} />)}
      </div>
    </div>
  </section>

  <section class="cp-section" aria-labelledby="cp-programme-compare">
    <div class="cp-container">
      <div class="cp-card cp-card--ivory cp-compare-cta">
        <h2 id="cp-programme-compare">Not sure which one fits?</h2>
        <p>
          Compare ECP, EFM, faculty development workshops, and custom programmes side by side — by audience, depth, duration, format, and next step.
        </p>
        <a class="cp-button cp-button--primary" href="/contemporary/programmes/compare">
          Compare programmes
        </a>
      </div>
    </div>
  </section>
</ContemporaryBaseLayout>

<style>
  .cp-page-header {
    padding: clamp(3rem, 1.5rem + 5vw, 5rem) 0 clamp(2rem, 1rem + 3vw, 3rem);
    background: var(--cp-color-ivory);
    border-bottom: 1px solid var(--cp-color-divider);
  }

  .cp-page-header h1 {
    margin: 0 0 1rem;
  }

  .cp-page-header .cp-lead {
    max-width: 60ch;
  }

  /*
   * Pracademic band (R4, t_6078f9e1) — visible emphasis band under
   * the PageHero so the term "pracademic" reads as a designed
   * statement, not a passing phrase in the lead. Centered card on
   * ivory background, distinct from the PageHero lead.
   */
  .cp-section--tight {
    padding-top: 0;
  }

  .cp-pracademic-band {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    margin: -1rem auto 0;
    padding: 1.5rem 1.75rem;
    background: var(--cp-color-white);
    border: 1px solid rgba(36, 47, 76, 0.15);
    border-left: 4px solid var(--cp-color-maroon);
    border-radius: var(--cp-radius-card);
    max-width: 760px;
    color: var(--cp-color-navy);
  }

  .cp-pracademic-band__eyebrow {
    font-family: var(--cp-font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cp-color-maroon);
  }

  .cp-pracademic-band__body {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--cp-color-navy);
  }

  .cp-pracademic-band__body strong {
    color: var(--cp-color-maroon);
    font-weight: 600;
  }

  .cp-section__intro {
    color: var(--cp-color-text-muted);
    max-width: 60ch;
    margin: 0 0 1.5rem;
  }

  .cp-compare-cta {
    text-align: center;
    align-items: center;
    gap: 1rem;
  }

  .cp-compare-cta h2 {
    margin: 0 0 0.5rem;
  }

  .cp-compare-cta p {
    color: var(--cp-color-text-muted);
    max-width: 50ch;
    margin: 0 auto 1.5rem;
  }
</style>
