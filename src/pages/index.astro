---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="iifr.global — coming soon"
  description="iifr.global rebuild — Phase 1 placeholder"
>
  <main class="mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center gap-6 px-6 py-24 text-center">
    <p class="text-xs font-semibold uppercase tracking-[0.4em] text-slate-500">
      Phase 1 · Foundation
    </p>
    <h1 class="text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">
      iifr.global — coming soon
    </h1>
    <p class="max-w-xl text-base text-slate-600">
      The new site is being built on Astro + Keystatic + Vercel. This page
      confirms the skeleton deploys. The Keystatic admin is available at
      <a class="font-medium text-slate-900 underline" href="/keystatic">/keystatic</a>
      once a deployment is live.
    </p>
    <p class="text-sm text-slate-500">
      Content migration starts in Phase 2. See
      <code class="rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-700">webdev-stack-plan-v3.md</code>
      for the full plan.
    </p>
  </main>
</BaseLayout>
