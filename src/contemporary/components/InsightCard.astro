---
/**
 * InsightCard — used in insights list and home preview.
 */
import type { Insight } from "../lib/content";
import { formatDDMMMYYYY } from "../lib/content";

interface Props {
  insight: Insight;
}

const { insight } = Astro.props as Props;
const date = formatDDMMMYYYY(insight.publishDate);
---

<a class="cp-card cp-card--link cp-insight-card" href={`/contemporary/events-and-insights/insights/${insight.slug}`}>
  <span class="cp-tag cp-tag--navy">{insight.topic}</span>
  <h3>{insight.title}</h3>
  <p>{insight.dek}</p>
  <ul class="cp-insight-card__meta">
    <li><strong>{insight.authorName}</strong></li>
    <li>{date}</li>
    <li>{insight.readingTime}</li>
  </ul>
</a>

<style>
  .cp-insight-card h3 {
    margin: 0.5rem 0 0.5rem;
    font-size: 1.15rem;
  }

  .cp-insight-card p {
    color: var(--cp-color-text-muted);
    margin: 0 0 1rem;
  }

  .cp-insight-card__meta {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.6rem;
    font-size: 0.8rem;
    color: var(--cp-color-text-muted);
  }

  .cp-insight-card__meta li + li::before {
    content: "·";
    margin-right: 0.6rem;
  }

  .cp-insight-card__meta strong {
    color: var(--cp-color-navy);
  }
</style>
