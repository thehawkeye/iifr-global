---
/**
 * /contemporary/programmes/[slug] — programme detail.
 *
 * Decision-support anatomy from design plan §5:
 *   1. Hero (name, status, audience, duration, format)
 *   2. Outcomes (what you will be able to do)
 *   3. Curriculum (modules)
 *   4. Faculty (mix, not individual bios — those live in /faculty)
 *   5. Cohort facts (separate from programme facts)
 *   6. Certification
 *   7. Next step (apply / enquire)
 *   8. Related content (other programmes, related insights)
 *
 * Data source: Sanity (GROQ) — replaces hardcoded content.ts.
 * Field names mirror content.ts Programme interface exactly.
 */
import ContemporaryBaseLayout from "../../../contemporary/layouts/ContemporaryBaseLayout.astro";
import { sanityClient } from "../../../lib/sanity.client";
import { programmes as staticProgrammes, getProgramme } from "../../../contemporary/lib/content";
import { SITE_URL, programmeCourseSchema } from "../../../contemporary/lib/seo";

// ---------------------------------------------------------------------------
// getStaticPaths — called at build time (Node.js, async)
// Inline GROQ queries so Astro's server optimizer can see them.
// Falls back to static content.ts when Sanity is unavailable (no dataset,
// no token, or network error).
// ---------------------------------------------------------------------------

export async function getStaticPaths() {
  try {
    const slugs = await sanityClient.fetch<{ slug: string }[]>(
      `*[_type == "programme" && defined(slug.current)] { "slug": slug.current }`
    );
    return slugs.map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
  } catch {
    // Sanity unavailable — fall back to static content so build still passes.
    return staticProgrammes.map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
  }
}

// ---------------------------------------------------------------------------
// Page render
// ---------------------------------------------------------------------------

const { slug } = Astro.props as { slug: string };

let programme: Awaited<ReturnType<typeof getProgramme>>;
try {
  programme = await sanityClient.fetch(
    `*[_type == "programme" && slug.current == $slug][0] {
      title, shortName, programmeType, proposition, audience, duration, format,
      description,
      outcomes,
      "curriculum": curriculum[] { module, description },
      "faculty": faculty[] { name, role },
      certification,
      "cohorts": cohorts[] {
        id, name, status, startDate, endDate,
        applicationDeadline, fee, format, location, capacity,
        applicationUrl, brochureUrl,
        "owner": { name, role, lastReviewedAt }
      },
      status, source,
      "owner": owner { name, role, lastReviewedAt }
    }`,
    { slug }
  );
} catch {
  // Sanity unavailable — fall back to static content.ts
  programme = getProgramme(slug) ?? undefined;
}

if (!programme) {
  throw new Error(`Programme not found: ${slug}`);
}

// First cohort with an application URL drives the CTA
const cohort = programme.cohorts?.[0];
const applicationHref =
  cohort?.applicationUrl ??
  `/contemporary/start?intent=${programme.status === "by-enquiry" ? "enquire" : "apply"}&programme=${slug}`;

const seo = {
  title: `${programme.title} | IIFR programme`,
  description: programme.proposition,
  keywords: `${programme.title}, IIFR, ${(programme.audience ?? []).join(", ")}`,
  canonical: `${SITE_URL}/contemporary/programmes/${slug}`,
  image: `${SITE_URL}/assets/images/hero-home.webp`,
  type: "website" as const,
  schema: "Course" as const,
};

const schema = cohort ? programmeCourseSchema(programme, cohort, seo.canonical) : undefined;

const statusLabel: Record<string, string> = {
  open: "Open for applications",
  "coming-soon": "Coming soon",
  "by-enquiry": "By enquiry",
  archived: "Archived",
};
---

<ContemporaryBaseLayout
  path={`/contemporary/programmes/${slug}`}
  seo={seo}
  schema={schema}
  breadcrumbs={[
    { label: "Home", href: "/contemporary" },
    { label: "Programmes", href: "/contemporary/programmes" },
    { label: programme.title },
  ]}
>
  <header class="cp-page-header cp-page-header--programme">
    <div class="cp-container">
      <span class={`cp-tag cp-tag--${programme.status === "open" ? "maroon" : programme.status === "by-enquiry" ? "gold" : "navy"}`}>
        {statusLabel[programme.status] ?? programme.status}
      </span>
      <h1>{programme.title}</h1>
      <p class="cp-lead">{programme.proposition}</p>
      <p class="cp-programme-pracademic" id={`cp-programme-pracademic-${slug}`}>
        <span class="cp-programme-pracademic__eyebrow">Built for the pracademic</span>
        <span class="cp-programme-pracademic__body">
          This programme is designed for the <strong>pracademic</strong> —
          practitioners who teach, research, and lead at the bridge between
          the classroom and the field.
        </span>
      </p>
      <dl class="cp-facts">
        <div><dt>Duration</dt><dd>{programme.duration}</dd></div>
        <div><dt>Format</dt><dd>{programme.format}</dd></div>
        <div><dt>Type</dt><dd>{programme.programmeType}</dd></div>
        {cohort?.startDate && <div><dt>Next start</dt><dd>{cohort.startDate}</dd></div>}
        {cohort && <div><dt>Fee</dt><dd>{cohort.fee}</dd></div>}
      </dl>
      <div class="cp-row">
        <a class="cp-button cp-button--primary" href={applicationHref}>
          {programme.status === "by-enquiry" ? "Enquire about this programme" : "Apply for this programme"}
        </a>
        <a class="cp-button cp-button--outline" href={`/contemporary/start?intent=brochure&programme=${slug}`}>
          Request brochure
        </a>
      </div>
    </div>
  </header>

  <section class="cp-section" aria-labelledby="cp-programme-audience">
    <div class="cp-container cp-container--narrow">
      <h2 id="cp-programme-audience">Who this programme is for</h2>
      <ul class="cp-audience-list">
        {(programme.audience ?? []).map((a: string) => <li>{a}</li>)}
      </ul>
    </div>
  </section>

  <section class="cp-section cp-section--ivory" aria-labelledby="cp-programme-outcomes">
    <div class="cp-container cp-container--narrow">
      <h2 id="cp-programme-outcomes">What you will be able to do</h2>
      <ul class="cp-outcomes">
        {(programme.outcomes ?? []).map((o: string) => <li>{o}</li>)}
      </ul>
    </div>
  </section>

  <section class="cp-section" aria-labelledby="cp-programme-curriculum">
    <div class="cp-container cp-container--narrow">
      <h2 id="cp-programme-curriculum">Curriculum at a glance</h2>
      <ol class="cp-curriculum">
        {(programme.curriculum ?? []).map((m: { module: string; description: string }, i: number) => (
          <li>
            <span class="cp-curriculum__num">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3>{m.module}</h3>
              <p>{m.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="cp-section cp-section--ivory" aria-labelledby="cp-programme-faculty">
    <div class="cp-container cp-container--narrow">
      <h2 id="cp-programme-faculty">Faculty mix</h2>
      <p>{(programme.faculty ?? []).map((f: { name: string; role: string }) => `${f.name} (${f.role})`).join("; ")}.</p>
      <p>
        <a href="/contemporary/research-and-faculty">See the full research and faculty hub</a>
        for named profiles, affiliations, and expertise.
      </p>
    </div>
  </section>

  {cohort && (
    <section class="cp-section" aria-labelledby="cp-programme-cohort">
      <div class="cp-container cp-container--narrow">
        <h2 id="cp-programme-cohort">Cohort facts</h2>
        <p class="cp-section__intro">
          Cohort data is published separately from programme data so dates and fees can be updated without rewriting the page.
        </p>
        <dl class="cp-facts cp-facts--dense">
          <div><dt>Cohort</dt><dd>{cohort.name}</dd></div>
          <div><dt>Status</dt><dd>{cohort.status}</dd></div>
          {cohort.startDate && <div><dt>Start</dt><dd>{cohort.startDate}</dd></div>}
          {cohort.endDate && <div><dt>End</dt><dd>{cohort.endDate}</dd></div>}
          {cohort.applicationDeadline && <div><dt>Application deadline</dt><dd>{cohort.applicationDeadline}</dd></div>}
          <div><dt>Format</dt><dd>{cohort.format}</dd></div>
          <div><dt>Location</dt><dd>{cohort.location}</dd></div>
          {cohort.capacity && <div><dt>Capacity</dt><dd>{cohort.capacity}</dd></div>}
          <div><dt>Fee</dt><dd>{cohort.fee}</dd></div>
        </dl>
        <p class="cp-cohort-owner">
          <small>Owner: {cohort.owner?.name ?? programme.owner?.name} · Last reviewed {cohort.owner?.lastReviewedAt ?? programme.owner?.lastReviewedAt} · Source: {programme.source}</small>
        </p>
      </div>
    </section>
  )}

  <section class="cp-section cp-section--ivory" aria-labelledby="cp-programme-cert">
    <div class="cp-container cp-container--narrow">
      <h2 id="cp-programme-cert">Certification</h2>
      <p>
        {(
          programme.certification ?? ""
        ).replace(
          /(Founding Batch Scholarship)/,
          '<span class="cp-cert-scholarship" id="cp-cert-scholarship">$1</span>'
        )}
      </p>
      {slug === "ecp" && (
        <aside class="cp-cert-callout" id="cp-cert-callout" aria-label="Founding Batch Scholarship reference">
          <span class="cp-cert-callout__eyebrow">Founding Batch Scholarship</span>
          <p class="cp-cert-callout__body">
            The ECP certification language references <strong>Founding Batch Scholarship</strong>.
            Eligibility and award are not specified in the public certification copy —
            they are set during the admissions conversation for the August 2026 cohort.
          </p>
          <a class="cp-button cp-button--ghost cp-cert-callout__cta" href="/contemporary/start?intent=enquire&programme=ecp">
            Talk to admissions
          </a>
        </aside>
      )}
    </div>
  </section>

  <section class="cp-section cp-section--navy" aria-labelledby="cp-programme-next">
    <div class="cp-container">
      <h2 id="cp-programme-next" class="cp-programme-next__title">Ready to take the next step?</h2>
      <p>
        {programme.status === "by-enquiry"
          ? "Talk to IIFR admissions. We will respond within two working days."
          : "Apply now or request the brochure."}
      </p>
      <div class="cp-row">
        <a class="cp-button cp-button--primary" href={applicationHref}>
          {programme.status === "by-enquiry" ? "Enquire" : "Apply"}
        </a>
        <a class="cp-button cp-button--outline" href="/contemporary/programmes/compare">
          Compare programmes
        </a>
      </div>
    </div>
  </section>
</ContemporaryBaseLayout>

<style>
  .cp-page-header--programme {
    background: var(--cp-color-white);
    border-bottom: 1px solid var(--cp-color-divider);
    padding-top: clamp(2.5rem, 1rem + 4vw, 4rem);
  }

  .cp-page-header--programme h1 {
    margin: 0.5rem 0 1rem;
  }

  .cp-page-header--programme .cp-row {
    margin-top: 1.5rem;
  }

  .cp-programme-pracademic {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    margin: 0.5rem 0 0;
    padding: 0.85rem 1.1rem;
    background: rgba(36, 47, 76, 0.06);
    border: 1px solid rgba(36, 47, 76, 0.18);
    border-left: 4px solid var(--cp-color-maroon);
    border-radius: var(--cp-radius-card);
    max-width: 60ch;
  }

  .cp-programme-pracademic__eyebrow {
    font-family: var(--cp-font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cp-color-maroon);
  }

  .cp-programme-pracademic__body {
    color: var(--cp-color-navy);
    font-size: 1rem;
    line-height: 1.55;
  }

  .cp-programme-pracademic__body strong {
    color: var(--cp-color-maroon);
    font-weight: 600;
  }

  /*
   * Founding Batch Scholarship inline highlight (R4, t_6078f9e1).
   * The exact phrase "Founding Batch Scholarship" from the ECP
   * certification field is wrapped in this span so the term reads
   * as a designed anchor without changing the underlying wording.
   */
  .cp-cert-scholarship {
    display: inline-block;
    padding: 0.05em 0.55em;
    margin: 0 0.1em;
    background: rgba(199, 153, 6, 0.18);
    border: 1px solid rgba(199, 153, 6, 0.55);
    border-radius: 6px;
    color: var(--cp-color-maroon);
    font-weight: 600;
    white-space: nowrap;
  }

  /*
   * Founding Batch Scholarship callout (R4, t_6078f9e1) — visible
   * card under the ECP certification paragraph so the scholarship
   * reference is not only inline-highlighted. References the exact
   * phrase "Founding Batch Scholarship" from the certification
   * field; explicitly does NOT invent an amount or eligibility
   * formula — those are routed to admissions.
   */
  .cp-cert-callout {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 1.25rem 1.5rem;
    background: linear-gradient(135deg, rgba(199, 153, 6, 0.12), rgba(140, 36, 46, 0.10));
    border: 1px solid rgba(140, 36, 46, 0.30);
    border-left: 4px solid var(--cp-color-maroon);
    border-radius: var(--cp-radius-card);
    color: var(--cp-color-navy);
  }

  .cp-cert-callout__eyebrow {
    font-family: var(--cp-font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cp-color-maroon);
  }

  .cp-cert-callout__body {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--cp-color-navy);
  }

  .cp-cert-callout__body strong {
    color: var(--cp-color-maroon);
    font-weight: 600;
  }

  .cp-cert-callout__cta {
    margin-top: 0.4rem;
  }

  .cp-facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem 1.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  @media (min-width: 768px) {
    .cp-facts {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .cp-facts div {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 0;
    border-top: 1px solid var(--cp-color-divider);
  }

  .cp-facts dt {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cp-color-text-muted);
  }

  .cp-facts dd {
    margin: 0;
    color: var(--cp-color-navy);
    font-weight: 500;
  }

  .cp-facts--dense {
    grid-template-columns: 1fr 1fr;
  }

  @media (min-width: 768px) {
    .cp-facts--dense {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .cp-section__intro {
    color: var(--cp-color-text-muted);
    margin: 0 0 1rem;
  }

  .cp-audience-list,
  .cp-outcomes {
    margin: 0;
    padding-left: 1.2em;
  }

  .cp-audience-list li,
  .cp-outcomes li {
    margin-bottom: 0.4rem;
  }

  .cp-curriculum {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .cp-curriculum li {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1rem 0;
    border-top: 1px solid var(--cp-color-divider);
  }

  .cp-curriculum__num {
    font-family: var(--cp-font-heading);
    font-size: 1.5rem;
    color: var(--cp-color-maroon);
    font-weight: 700;
  }

  .cp-curriculum h3 {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
  }

  .cp-curriculum p {
    margin: 0;
    color: var(--cp-color-text-muted);
  }

  .cp-cohort-owner {
    margin-top: 1rem;
    color: var(--cp-color-text-muted);
  }

  .cp-programme-next__title {
    color: var(--cp-color-white);
  }
</style>
