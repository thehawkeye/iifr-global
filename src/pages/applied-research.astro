---
/**
 * applied-research.astro — the Applied Research page.
 *
 * Phase 2 T3 (t_18777968): port of `app/applied-research.php` (live crawl
 * fallback — the mirror copy was missing) with the T3 fixes applied:
 *
 *   1. Hero text readability (desktop + mobile): same dark-overlay +
 *      white-copy + text-shadow pattern that T4 wired into
 *      `src/styles/t4-hero-contrast.css`. The Applied Research hero
 *      carries the `iifr-hero-contrast--applied-research` scope so the
 *      legacy stylesheet keeps rendering the page chrome and only the
 *      T4 contrast layer kicks in.
 *
 *   2. Restore / fix the "How We Deliver" icons. The live PHP ships
 *      bare numbered nodes (`<span class="ecp-step__num">1</span>`).
 *      The EFM page's analogous "Programme Journey" section uses
 *      inline FontAwesome icons (`fa-light fa-graduation-cap`, etc.).
 *      We adopt the same pattern: a `<i>` icon paired with the step
 *      number, so the step reads as an icon-led card on both desktop
 *      and mobile.
 *
 * Sections (mirrors the live PHP 1:1 except for the icons):
 *   Hero → Quick Facts Bar → Programme Overview → Who Should Attend →
 *   What You'll Gain → How We Deliver (with icons) → Workshop Tracks →
 *   Bring It In-House.
 *
 * Legacy asset references go through `assetUrl()` so the existing asset
 * tree stays read-only (per M5). Internal links use clean Astro paths
 * (no `.php`). The `/applied-research` SEO entry is defined in
 * `src/lib/seo.ts`.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import { assetUrl } from "../lib/assetUrl";

interface DeliveryStep {
  icon: string;
  num: string;
  title: string;
  desc: string;
}

const deliverySteps: DeliveryStep[] = [
  {
    icon: "fa-light fa-users",
    num: "1",
    title: "Open Enrolment",
    desc: "Cohorts at the BVB Delhi campus, typically 1–3 days.",
  },
  {
    icon: "fa-light fa-building",
    num: "2",
    title: "In-House",
    desc: "Custom delivery at your institution, configured to your faculty needs.",
  },
  {
    icon: "fa-light fa-laptop",
    num: "3",
    title: "Hybrid",
    desc: "Short residency combined with virtual follow-through.",
  },
];
---

<SiteLayout path="/applied-research" bodyClass="iifr-redesign-scope iifr-hero-contrast">
  <!-- ============ HERO ============ -->
  <div class="iifr-page-hero iifr-hero-contrast--applied-research">
    <div
      class="iifr-page-hero__bg"
      style={`background-image:url('${assetUrl("assets/images/research/workshops-hero.jpg")}');background-position:center 35%;`}
    ></div>
    <div class="iifr-page-hero__inner">
      <span class="iifr-page-hero__eyebrow">Short-Format Programmes</span>
      <h1>Research &amp; Faculty Workshops</h1>
      <p>Short-format workshops for teaching, research, and leadership teams in higher education institutions.</p>
      <div class="iifr-page-hero__cta">
        <a href="/contact" class="iifr-btn-primary">Request a Workshop</a>
        <a
          href="/apply"
          class="iifr-btn-outline"
          data-bs-toggle="modal"
          data-bs-target="#iifrApplyModal"
          data-iifr-lead-intent="apply">Open Enrolment</a>
      </div>
    </div>
  </div>

  <!-- ============ QUICK FACTS BAR ============ -->
  <div class="ecp-facts-wrap">
    <div class="ecp-facts">
      <div class="ecp-fact">
        <span class="ecp-fact__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>
        </span>
        <div class="ecp-fact__body">
          <span class="ecp-fact__label">Duration</span>
          <span class="ecp-fact__value">1–5 Days</span>
          <span class="ecp-fact__sub">Short-format</span>
        </div>
      </div>
      <div class="ecp-fact">
        <span class="ecp-fact__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
        </span>
        <div class="ecp-fact__body">
          <span class="ecp-fact__label">Format</span>
          <span class="ecp-fact__value">In-house / Open</span>
          <span class="ecp-fact__sub">Hybrid available</span>
        </div>
      </div>
      <div class="ecp-fact">
        <span class="ecp-fact__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 4h16v6H4zM4 14h16v6H4z"/></svg>
        </span>
        <div class="ecp-fact__body">
          <span class="ecp-fact__label">Tracks</span>
          <span class="ecp-fact__value">4 Core + Custom</span>
          <span class="ecp-fact__sub">Configurable</span>
        </div>
      </div>
      <div class="ecp-fact">
        <span class="ecp-fact__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13A4 4 0 0 1 16 11"/></svg>
        </span>
        <div class="ecp-fact__body">
          <span class="ecp-fact__label">Audience</span>
          <span class="ecp-fact__value">Faculty &amp; Teams</span>
          <span class="ecp-fact__sub">Institutions &amp; L&amp;D</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ PROGRAMME OVERVIEW ============ -->
  <section class="iifr-section">
    <div class="ecp-overview">
      <div class="ecp-overview__text">
        <span class="iifr-eyebrow">Workshop Overview</span>
        <h2 class="ecp-overview__title">Focused Capability-Building in a Compressed Window</h2>
        <hr class="iifr-gold-line">
        <p>IIFR's workshops are outcome-oriented and designed for faculty, research teams, and institutional leaders who need practical capability-building quickly.</p>
        <p>Each format supports either open participation or in-house delivery, depending on institutional priorities.</p>
        <div class="ecp-tags">
          <span class="ecp-tag">Focused</span>
          <span class="ecp-tag">Modular</span>
          <span class="ecp-tag">In-house</span>
          <span class="ecp-tag">Hybrid</span>
        </div>
      </div>
      <div class="ecp-overview__media">
        <img src={assetUrl("assets/images/research/research-overview.png")} alt="IIFR faculty research workshop" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <!-- ============ WHO SHOULD ATTEND ============ -->
  <section class="iifr-section iifr-paper">
    <div class="iifr-section__head iifr-section__head--center">
      <h2>Who Participates?</h2>
      <hr class="iifr-gold-line-center">
    </div>
    <div class="ecp-audience">
      <article class="ecp-aud-card">
        <span class="ecp-aud-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 21h18M5 21V8l7-4 7 4v13M9 21v-6h6v6"/></svg>
        </span>
        <h3 class="ecp-aud-card__title">Faculty Members</h3>
        <p class="ecp-aud-card__desc">At universities, business schools, and professional institutes seeking sharper teaching and research practice.</p>
      </article>
      <article class="ecp-aud-card">
        <span class="ecp-aud-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h6M8 16h4"/></svg>
        </span>
        <h3 class="ecp-aud-card__title">Research Scholars</h3>
        <p class="ecp-aud-card__desc">Research scholars and early-career academics building publishing readiness and methodology.</p>
      </article>
      <article class="ecp-aud-card">
        <span class="ecp-aud-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 21h18M5 21V10M9 21V10M15 21V10M19 21V10M3 10l9-6 9 6z"/></svg>
        </span>
        <h3 class="ecp-aud-card__title">Deans &amp; Administrators</h3>
        <p class="ecp-aud-card__desc">Department heads, deans, and academic administrators leading programmes and institutional change.</p>
      </article>
      <article class="ecp-aud-card">
        <span class="ecp-aud-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/></svg>
        </span>
        <h3 class="ecp-aud-card__title">L&amp;D Teams</h3>
        <p class="ecp-aud-card__desc">Corporate L&amp;D teams adopting academic-grade learning practices and capability frameworks.</p>
      </article>
    </div>
  </section>

  <!-- ============ WHAT YOU'LL GAIN ============ -->
  <section class="iifr-section ecp-learn-band">
    <div class="iifr-section__head iifr-section__head--center">
      <span class="iifr-eyebrow">Outcomes</span>
      <h2>What Participants Will Gain</h2>
      <hr class="iifr-gold-line-center">
    </div>
    <div class="ecp-learn">
      <article class="ecp-learn-card">
        <span class="ecp-learn-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M21 21v-2a4 4 0 0 0-3-3.87"/></svg>
        </span>
        <h3 class="ecp-learn-card__title">Sharper Pedagogy</h3>
        <p class="ecp-learn-card__desc">Case-based teaching, classroom design, assessment, and stronger learner engagement.</p>
      </article>
      <article class="ecp-learn-card">
        <span class="ecp-learn-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h6M8 16h4"/></svg>
        </span>
        <h3 class="ecp-learn-card__title">Publishable Research</h3>
        <p class="ecp-learn-card__desc">Research design, scholarly writing, publishing readiness, and applied methodology.</p>
      </article>
      <article class="ecp-learn-card">
        <span class="ecp-learn-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 21h18M5 21V10M9 21V10M15 21V10M19 21V10M3 10l9-6 9 6z"/></svg>
        </span>
        <h3 class="ecp-learn-card__title">Stronger Leadership</h3>
        <p class="ecp-learn-card__desc">Department leadership, programme design, and institutional change capability.</p>
      </article>
      <article class="ecp-learn-card">
        <span class="ecp-learn-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 9h6v6H9zM12 1v3M12 20v3M1 12h3M20 12h3"/></svg>
        </span>
        <h3 class="ecp-learn-card__title">AI-Enabled Teaching</h3>
        <p class="ecp-learn-card__desc">Practical AI-enabled pedagogy for preparation, assessment, and delivery.</p>
      </article>
      <article class="ecp-learn-card">
        <span class="ecp-learn-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="9" r="6"/><path d="M9 14.5L8 22l4-2 4 2-1-7.5"/></svg>
        </span>
        <h3 class="ecp-learn-card__title">Accreditation Readiness</h3>
        <p class="ecp-learn-card__desc">Programme and faculty practices aligned with accreditation and quality benchmarks.</p>
      </article>
      <article class="ecp-learn-card">
        <span class="ecp-learn-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3 2 8l10 5 10-5-10-5zM6 10.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-5.5"/></svg>
        </span>
        <h3 class="ecp-learn-card__title">Pracademic Practice</h3>
        <p class="ecp-learn-card__desc">Translate senior practice into teaching cases, scholarship, and institutional contributions.</p>
      </article>
    </div>
  </section>

  <!-- ============ HOW WE DELIVER ============ -->
  <section class="iifr-section iifr-cream" id="how-we-deliver">
    <div class="iifr-section__head iifr-section__head--center">
      <span class="iifr-eyebrow">Flexible Delivery</span>
      <h2>How We Deliver</h2>
      <hr class="iifr-gold-line-center">
    </div>
    <ol class="ecp-journey ecp-journey--three">
      {deliverySteps.map((step) => (
        <li class="ecp-step">
          <span class="ecp-step__node" aria-hidden="true">
            <i class={step.icon}></i>
            <span class="ecp-step__num">{step.num}</span>
          </span>
          <h3 class="ecp-step__title">{step.title}</h3>
          <p class="ecp-step__desc">{step.desc}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ============ WORKSHOP TRACKS ============ -->
  <section class="iifr-section" id="tracks">
    <div class="iifr-section__head iifr-section__head--center">
      <span class="iifr-eyebrow">The Curriculum</span>
      <h2>Workshop Tracks</h2>
      <hr class="iifr-gold-line-center">
      <p class="iifr-lead">Four core tracks, configurable to your institution's priorities.</p>
    </div>
    <div class="iifr-grid iifr-grid--2" style="gap:20px;max-width:1080px;margin:0 auto;">
      <article class="iifr-module-card">
        <span class="iifr-module-card__num">Track A</span>
        <h3 class="iifr-module-card__title">Teaching Excellence</h3>
        <ul class="iifr-module-card__topics">
          <li><span>Case-based teaching</span></li>
          <li><span>AI-enabled pedagogy</span></li>
          <li><span>Classroom design &amp; assessment</span></li>
          <li><span>Learner engagement</span></li>
        </ul>
      </article>
      <article class="iifr-module-card">
        <span class="iifr-module-card__num">Track B</span>
        <h3 class="iifr-module-card__title">Research Capability</h3>
        <ul class="iifr-module-card__topics">
          <li><span>Research design</span></li>
          <li><span>Scholarly writing</span></li>
          <li><span>Publishing readiness</span></li>
          <li><span>Applied-research methodology</span></li>
        </ul>
      </article>
      <article class="iifr-module-card">
        <span class="iifr-module-card__num">Track C</span>
        <h3 class="iifr-module-card__title">Academic Leadership</h3>
        <ul class="iifr-module-card__topics">
          <li><span>Department leadership</span></li>
          <li><span>Programme design</span></li>
          <li><span>Accreditation readiness</span></li>
          <li><span>Institutional change</span></li>
        </ul>
      </article>
      <article class="iifr-module-card">
        <span class="iifr-module-card__num">Track D</span>
        <h3 class="iifr-module-card__title">Pracademic Practice</h3>
        <ul class="iifr-module-card__topics">
          <li><span>Translating senior practice into teaching cases</span></li>
          <li><span>Scholarship development</span></li>
          <li><span>Institutional contributions</span></li>
        </ul>
      </article>
    </div>
  </section>

  <!-- ============ KEY FOCUS: BRING IT IN-HOUSE ============ -->
  <section class="iifr-section iifr-paper" id="in-house">
    <div class="ecp-overview ecp-overview--reverse">
      <div class="ecp-overview__media">
        <img src={assetUrl("assets/images/research/research-focus.png")} alt="IIFR in-house faculty workshop" loading="lazy" decoding="async" />
      </div>
      <div class="ecp-overview__text">
        <span class="iifr-eyebrow">For Institutions</span>
        <h2 class="ecp-overview__title">Bring a Workshop In-House</h2>
        <hr class="iifr-gold-line">
        <p>Tell us about your team and goals, and we'll design the right workshop for your faculty — delivered at your campus, online, or as a hybrid residency.</p>
        <p>Custom tracks can be combined and tailored to your institution's strategic priorities and accreditation goals.</p>
        <div class="iifr-page-hero__cta" style="margin-top:8px;">
          <a href="/contact" class="iifr-btn-dark">Request a Workshop</a>
          <a
            href="/apply"
            class="iifr-btn-ghost"
            data-bs-toggle="modal"
            data-bs-target="#iifrApplyModal"
            data-iifr-lead-intent="apply">Open Enrolment</a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>