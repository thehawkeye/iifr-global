---
/**
 * Hero — homepage and top-of-page hero.
 *
 * Murali spec (L1, t_dadf4467, 2026-08-06, refined 22:48 IST):
 *   - Watercolor hero — artistic, NOT the building photograph.
 *     Layered radial gradients in the navy / maroon / gold palette +
 *     three blurred "bloom" discs that suggest wet pigment bleeding
 *     into paper. Clear gradient fade to ivory at the bottom.
 *   - IIFR emblem + full institute name as a quiet crest above the title.
 *   - TrustStrip moved to a separate <TrustStrip /> component below
 *     (matches iifr.global's navy band with label/value pairs).
 *   - NO live-cohort signal pill in the hero (Murali 22:48 — classy,
 *     not crass; the pill decoration was the wrong call).
 *   - NO Founding Batch Scholarship callout in the hero (same).
 *     The term lives in the ECP detail body as plain prose.
 *   - NO "Pracademic" highlight in the hero (Murali 22:48 — the term
 *     belongs in body copy, not in styled callouts).
 */
import { programmes } from "../lib/content";

interface Cta {
  href: string;
  label: string;
  variant?: "primary" | "outline" | "ghost" | "secondary";
}

interface Props {
  title: string;
  /** A one- or two-sentence value proposition. */
  lead: string;
  primary: Cta;
  secondary?: Cta;
}

const { title, lead, primary, secondary } = Astro.props as Props;

// `programmes` is imported to keep the live-cohort signal logic available
// for callers that opt in later (e.g. the ECP detail page), but the home
// hero does not render it.
void programmes;
---

<section class="cp-hero" aria-labelledby="cp-hero-title">
  <div class="cp-hero__wash" aria-hidden="true"></div>
  <div class="cp-hero__bloom cp-hero__bloom--gold" aria-hidden="true"></div>
  <div class="cp-hero__bloom cp-hero__bloom--maroon" aria-hidden="true"></div>
  <div class="cp-hero__bloom cp-hero__bloom--ink" aria-hidden="true"></div>

  <div class="cp-container cp-container--wide cp-hero__inner">
    <div class="cp-hero__copy">
      <a class="cp-hero__brand" href="/contemporary" aria-label="IIFR — home">
        <img
          class="cp-hero__emblem"
          src="/assets/logo.webp"
          alt="IIFR emblem"
          width="56"
          height="56"
          decoding="async"
        />
        <span class="cp-hero__brand-name">
          International Institute for Faculty &amp; Research
        </span>
      </a>

      <h1 id="cp-hero-title" class="cp-hero__title">{title}</h1>
      <p class="cp-hero__lead">{lead}</p>

      <div class="cp-hero__actions">
        <a class={`cp-button cp-button--${primary.variant ?? "primary"}`} href={primary.href}>
          {primary.label}
        </a>
        {secondary && (
          <a class={`cp-button cp-button--${secondary.variant ?? "outline"}`} href={secondary.href}>
            {secondary.label}
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * Watercolor hero: layered radial gradients in the brand palette +
   * three blurred "bloom" discs (gold, maroon, ink) suggesting wet
   * pigment bleeding into paper. The bottom fades to ivory so the
   * hero lands visually into the rest of the page.
   */
  /*
   * Z-index scheme (FIX 2026-08-07, Murali: "no watercolor hero on home"):
   *   .cp-hero         — no opaque background (was `var(--cp-color-ivory)`,
   *                      which was painting OVER the art layer and hiding
   *                      the watercolor). The wash supplies the bottom
   *                      fade to ivory instead.
   *   .cp-hero__wash   — z-index 0; art layer
   *   .cp-hero__bloom* — z-index 1; on top of wash, but below copy
   *   .cp-hero__inner  — z-index 2; copy + CTAs read on top of art
   * No `isolation: isolate` — we want everything in normal flow.
   */
  .cp-hero {
    position: relative;
    overflow: hidden;
    min-height: clamp(440px, 62vh, 660px);
    display: flex;
    align-items: center;
    color: #ffffff;
    padding: clamp(3rem, 2rem + 4vw, 5rem) 0;
  }

  .cp-hero__wash {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(
        ellipse 55% 65% at 8% 12%,
        rgba(199, 153, 6, 0.55) 0%,
        rgba(199, 153, 6, 0) 60%
      ),
      radial-gradient(
        ellipse 50% 60% at 92% 8%,
        rgba(108, 19, 27, 0.60) 0%,
        rgba(108, 19, 27, 0) 65%
      ),
      radial-gradient(
        ellipse 65% 70% at 50% 50%,
        rgba(36, 47, 76, 0.85) 0%,
        rgba(36, 47, 76, 0.65) 45%,
        rgba(36, 47, 76, 0) 80%
      ),
      linear-gradient(
        180deg,
        rgba(36, 47, 76, 0.95) 0%,
        rgba(36, 47, 76, 0.90) 40%,
        rgba(239, 235, 229, 0) 78%,
        var(--cp-color-ivory) 100%
      );
  }

  .cp-hero__bloom {
    position: absolute;
    border-radius: 50%;
    filter: blur(56px);
    opacity: 0.75;
    pointer-events: none;
    z-index: 1;
  }

  .cp-hero__bloom--gold {
    width: 42%;
    aspect-ratio: 1;
    left: 2%;
    top: 4%;
    background: radial-gradient(circle at 30% 30%,
      rgba(199, 153, 6, 0.85) 0%,
      rgba(199, 153, 6, 0) 70%);
  }

  .cp-hero__bloom--maroon {
    width: 38%;
    aspect-ratio: 1;
    right: 4%;
    bottom: 8%;
    background: radial-gradient(circle at 60% 60%,
      rgba(108, 19, 27, 0.80) 0%,
      rgba(108, 19, 27, 0) 70%);
  }

  .cp-hero__bloom--ink {
    width: 32%;
    aspect-ratio: 1;
    left: 36%;
    top: 40%;
    background: radial-gradient(circle at 50% 50%,
      rgba(36, 47, 76, 0.70) 0%,
      rgba(36, 47, 76, 0) 70%);
  }

  .cp-hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .cp-hero__copy {
    max-width: 60ch;
  }

  .cp-hero__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.75rem;
    text-decoration: none;
    color: inherit;
  }

  .cp-hero__brand:hover,
  .cp-hero__brand:focus-visible {
    color: inherit;
    text-decoration: none;
  }

  .cp-hero__emblem {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
  }

  .cp-hero__brand-name {
    font-family: var(--cp-font-heading);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #ffffff;
    line-height: 1.25;
    max-width: 26ch;
  }

  .cp-hero__title {
    color: #ffffff;
    font-size: var(--cp-font-size-title);
    margin: 0 0 1rem;
    letter-spacing: -0.01em;
    text-wrap: balance;
    text-shadow: 0 2px 24px rgba(36, 47, 76, 0.35);
  }

  .cp-hero__lead {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.92);
    max-width: 58ch;
    margin: 0 0 1.75rem;
    text-shadow: 0 1px 12px rgba(36, 47, 76, 0.35);
  }

  .cp-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cp-hero__actions .cp-button--outline {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.7);
  }

  .cp-hero__actions .cp-button--outline:hover,
  .cp-hero__actions .cp-button--outline:focus-visible {
    background: #ffffff;
    color: var(--cp-color-navy);
  }

  @media (prefers-reduced-motion: reduce) {
    .cp-hero__bloom {
      filter: blur(32px);
    }
  }
</style>