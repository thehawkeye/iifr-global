{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "$comment": "Phase 1 Vercel config for the iifr.global rebuild. Replaces the legacy PHP staging/vercel.json model with a static-first Astro + Keystatic project.",
  "cleanUrls": true,
  "trailingSlash": false,
  "github": {
    "silent": true,
    "autoAlias": false
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/keystatic/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "redirects": []
}
